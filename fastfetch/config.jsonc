{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // ---------------------------------------------------------------------
  // Logo: B-DNA, the Dickerson dodecamer (PDB 1BNA), drawn with kitty's
  // graphics protocol.
  //
  // "kitty-direct" hands kitty the file path and lets it decode and blit the
  // actual pixels, so what you see is the image itself — not an ASCII
  // approximation of it. This only works in a terminal that speaks the kitty
  // graphics protocol; see config-ascii.jsonc for the portable fallback.
  //
  // The source is a copy kept beside this config on purpose, so reorganising
  // ~/Projects can't break your prompt.
  // ---------------------------------------------------------------------
  "logo": {
    // The source MUST be a PNG. kitty's graphics protocol accepts only
    // f=24 (raw RGB), f=32 (raw RGBA) and f=100 (PNG) — there is no JPEG
    // support. Pointing this at a .jpg makes kitty try to parse JPEG bytes
    // as PNG, fail, and render nothing at all, silently.
    // dna-helix.png comes out of PyMOL's ray tracer with a transparent
    // background, rendered from public-domain PDB coordinates with
    //     tools/pdb-logo.py 1bna --name dna-helix --upright --rows 26
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/dna-helix.png",

    // Bounding box in terminal cells, not pixels.
    //
    // The image is 450x893 (aspect 0.504). A character cell is about 2.2x
    // taller than it is wide, so a faithful 26-row block needs:
    //     cols = 0.504 x 26 rows x 2.2  =  28.8  ->  29
    // This matters if the terminal can't report its cell size in pixels: in
    // that case preserveAspectRatio has nothing to measure and this box is
    // used literally.
    //
    // If you change one of these, rescale the other by the same ratio.
    "width": 29,
    "height": 26,

    // The guarantee against distortion: fit inside width x height without
    // stretching either axis. Never set this false with a non-matching box.
    "preserveAspectRatio": true,

    // Left padding indents the block; right padding is the gutter before the
    // info column. Raise "right" if the two feel cramped.
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },

  // ---------------------------------------------------------------------
  // Display
  // ---------------------------------------------------------------------
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;5;39",
      "title": "38;5;123"
    }
  },

  // ---------------------------------------------------------------------
  // Modules: fastfetch's stock default set, listed explicitly.
  //
  // This list is not optional — a config file with no "modules" key renders
  // the logo and nothing else, rather than falling back to the defaults.
  //
  // Delete any line to drop that row. `fastfetch --list-modules` shows every
  // available module. To put a Nerd Font icon on a row (you have Fantasque
  // Sans Mono Nerd Font installed), replace the bare string with an object:
  //   { "type": "os", "key": " 󰣛" }
  // ---------------------------------------------------------------------
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ]
}
