#!/usr/bin/env python3
"""Resolve a biological identifier to its database page and open it.

Wired to the hints kitten (ctrl+shift+b > a): kitty finds identifier-shaped
text on screen, you pick one, and this decides which database it belongs to.
hints passes the match as an argument — it has no URL templating of its own,
which is why this script exists rather than a one-line mapping in kitty.conf.

    biokitty-accession 1EMA              # opens the RCSB page
    biokitty-accession --print P0DTC2    # prints the URL, opens nothing
    biokitty-accession --selftest        # check the pattern table

Unrecognised text falls back to an NCBI all-database search, so the binding
is still useful on a gene symbol or a free-text term.
"""

from __future__ import annotations

import re
import subprocess
import sys
from urllib.parse import quote

# Ordered: the first pattern that matches wins, so put the specific ones
# first. PDB IDs are only four characters and would otherwise be shadowed.
RESOLVERS: list[tuple[str, str, str]] = [
    # (label, regex, url template using {id})
    ('DOI',        r'^10\.\d{4,9}/\S+$',                      'https://doi.org/{id}'),
    ('GO term',    r'^GO:\d{7}$',                             'https://amigo.geneontology.org/amigo/term/{id}'),
    ('Pfam',       r'^PF\d{5}$',                              'https://www.ebi.ac.uk/interpro/entry/pfam/{id}/'),
    ('InterPro',   r'^IPR\d{6}$',                             'https://www.ebi.ac.uk/interpro/entry/InterPro/{id}/'),
    ('GEO',        r'^GS[EMP]\d+$',                           'https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc={id}'),
    ('SRA run',    r'^[SED]RR\d+$',                           'https://www.ncbi.nlm.nih.gov/sra/{id}'),
    ('BioProject', r'^PRJ[A-Z]{2}\d+$',                       'https://www.ncbi.nlm.nih.gov/bioproject/{id}'),
    ('Ensembl',    r'^ENS[A-Z]*[GTP]\d{6,}(\.\d+)?$',         'https://www.ensembl.org/id/{id}'),
    ('RefSeq prot', r'^[NXWA]P_\d+(\.\d+)?$',                 'https://www.ncbi.nlm.nih.gov/protein/{id}'),
    ('RefSeq nuc', r'^[NXW][MRCGTW]_\d+(\.\d+)?$',            'https://www.ncbi.nlm.nih.gov/nuccore/{id}'),
    ('assembly',   r'^GC[AF]_\d+\.\d+$',                      'https://www.ncbi.nlm.nih.gov/datasets/genome/{id}/'),
    ('UniProt',    r'^([OPQ]\d[A-Z0-9]{3}\d|[A-NR-Z]\d([A-Z][A-Z0-9]{2}\d){1,2})$',
                                                              'https://www.uniprot.org/uniprotkb/{id}/entry'),
    ('PMID',       r'^(?:PMID:?\s*)?(\d{7,8})$',              'https://pubmed.ncbi.nlm.nih.gov/{id}/'),
    ('PDB',        r'^\d[A-Za-z0-9]{3}$',                     'https://www.rcsb.org/structure/{id}'),
]

FALLBACK = 'https://www.ncbi.nlm.nih.gov/search/all/?term={id}'


def resolve(text: str) -> tuple[str, str]:
    """Return (label, url) for an identifier."""
    ident = text.strip().strip('.,;:()[]<>"\'')
    for label, pattern, template in RESOLVERS:
        m = re.match(pattern, ident, re.IGNORECASE)
        if m:
            # PMID captures the bare number so the "PMID:" prefix is dropped.
            value = m.group(1) if label == 'PMID' else ident
            if label in ('PDB', 'UniProt', 'RefSeq nuc', 'RefSeq prot'):
                value = value.upper()
            return label, template.format(id=value)
    return 'search', FALLBACK.format(id=quote(ident))


def selftest() -> int:
    cases = [
        ('1EMA',              'PDB'),
        ('4hhb',              'PDB'),
        ('P0DTC2',            'UniProt'),
        ('Q9NZC2',            'UniProt'),
        ('NM_000546.6',       'RefSeq nuc'),
        ('NP_000537',         'RefSeq prot'),
        ('ENSG00000141510',   'Ensembl'),
        ('GSE12345',          'GEO'),
        ('SRR1234567',        'SRA run'),
        ('PRJNA12345',        'BioProject'),
        ('GCF_000001405.40',  'assembly'),
        ('GO:0006915',        'GO term'),
        ('PF00042',           'Pfam'),
        ('IPR001245',         'InterPro'),
        ('10.1038/nature12373', 'DOI'),
        ('PMID:31452104',     'PMID'),
        ('31452104',          'PMID'),
        ('TP53',              'search'),
        ('some random words', 'search'),
    ]
    bad = []
    for text, want in cases:
        got, url = resolve(text)
        if got != want:
            bad.append(f'{text!r}: got {got}, want {want}')
        else:
            print(f'  {text:<22} {got:<12} {url}')
    for b in bad:
        print('FAIL ' + b, file=sys.stderr)
    print(f'{"FAILED" if bad else "ok"}: {len(bad)} failure(s)',
          file=sys.stderr if bad else sys.stdout)
    return 1 if bad else 0


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ('-h', '--help'):
        print(__doc__)
        return 0
    if argv[0] == '--selftest':
        return selftest()

    print_only = argv[0] == '--print'
    if print_only:
        argv = argv[1:]
    if not argv:
        print('nothing to resolve', file=sys.stderr)
        return 2

    label, url = resolve(' '.join(argv))
    if print_only:
        print(f'{label}\t{url}')
        return 0

    print(f'{label}: {url}')
    try:
        subprocess.Popen(['xdg-open', url],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError as e:
        print(f'could not open a browser: {e}', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
